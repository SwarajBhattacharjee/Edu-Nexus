# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ──
.Python
env/
venv/
.venv/

# ── Distribution / Packaging ──
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Environment Variables (CRITICAL) ──
.env
.env.local
.env.*.local

# ── Data Storage (don't commit user data) ──
data/auth/*
data/raw/*
data/processed/*
data/artifacts/**
!data/auth/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/artifacts/.gitkeep
!data/artifacts/qdrant/.gitkeep
!data/artifacts/bm25/.gitkeep
!data/artifacts/graphs/.gitkeep

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Jupyter ──
.ipynb_checkpoints/

# ── Agent context ──
# NOTE: .agents/ is NOT ignored — it contains project workflows and context
# that must be present in the deployed codebase.
# Only ignore the Gemini/IDE agent cache:
.gemini/

# ── Frontend ──
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# ── Chainlit (legacy) ──
.chainlit/

# ── OS files ──
Thumbs.db
.DS_Store
desktop.ini

# ── Misc ──
*.log
*.bak
skills-lock.json
.playwright-mcp/

# ── Session Data ──
sessions/
.sessions/
*.session
*.session-journal
session.dbattached_assets/
